#!/bin/bash
# Demo stand-in for an AI coding agent: sends the same PreToolUse payload
# Claude Code / Codex would send, into the hooks omh generated.
GREEN=$'\e[32m'; RED=$'\e[31m'; DIM=$'\e[2m'; BOLD=$'\e[1m'; RST=$'\e[0m'
decide() { # $1 hook, $2 tool_input json
  local hook=".omh/hooks/catalog-$1.sh"
  if [ ! -x "$hook" ]; then echo "agent: missing hook $hook (run omh init first)" >&2; exit 1; fi
  jq -cn --argjson ti "$2" '{tool_input:$ti}' | "$hook" 2>"$TMP"
}
TMP=$(mktemp)
case "$1" in
  run)
    echo "${DIM}agent → Bash: ${RST}$2"
    TI=$(jq -cn --arg c "$2" '{command:$c}')
    OUT=$(decide command-guard "$TI") || exit 1
    [ -z "$OUT" ] && { OUT=$(decide commit-test-gate "$TI") || exit 1; }
    grep -E "^\s+×|AssertionError|expected" "$TMP" | head -2 | sed "s/^/   ${RED}/;s/$/${RST}/"
    ;;
  edit)
    echo "${DIM}agent → Edit: ${RST}$2"
    OUT=$(decide tdd-guard "$(jq -cn --arg f "$PWD/$2" '{file_path:$f}')") || exit 1
    ;;
esac
if echo "$OUT" | jq -e '.decision=="block"' >/dev/null 2>&1; then
  echo "   ${RED}${BOLD}⛔ BLOCKED${RST}  $(echo "$OUT" | jq -r .reason)"
else
  echo "   ${GREEN}✔ allowed${RST}"
fi
rm -f "$TMP"
